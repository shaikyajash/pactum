.PHONY: build test abi fmt demo

build:
	forge build
	cd resolver && npm run build

test:
	forge test -vv
	cd resolver && npm test

abi:
	@{ echo '// generated by `make abi` — do not edit'; \
	   for c in HashLock PactumIntents; do \
	     printf 'export const %sAbi = ' "$$(node -e "const s=process.argv[1];console.log(s[0].toLowerCase()+s.slice(1))" $$c)"; \
	     forge inspect $$c abi --json | node -e 'process.stdout.write(JSON.stringify(JSON.parse(require("fs").readFileSync(0))))'; \
	     echo ' as const;'; \
	   done; } > resolver/src/abi.ts

fmt:
	forge fmt
