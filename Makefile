.PHONY: build test abi fmt demo

build:
	forge build
	cd resolver && npm run build

test:
	forge test -vv
	cd resolver && npm test

abi:
	@{ echo '// generated by `make abi` — do not edit'; \
	   printf 'export const hashLockAbi = '; \
	   forge inspect HashLock abi --json | node -e 'process.stdout.write(JSON.stringify(JSON.parse(require("fs").readFileSync(0))))'; \
	   echo ' as const;'; } > resolver/src/abi.ts

fmt:
	forge fmt
